---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { byNewest, imageSrcSet, mediaUrl, postUrl } from '../../lib/gallery';

const posts = (await getCollection('posts')).sort(byNewest);

type Group = { tag: string; posts: typeof posts };

const groups = new Map<string, Group>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    const group = groups.get(tag) ?? { tag, posts: [] };
    group.posts.push(post);
    groups.set(tag, group);
  }
}

const sortedGroups = [...groups.values()].sort(
  (a, b) => b.posts.length - a.posts.length || a.tag.localeCompare(b.tag),
);
---

<BaseLayout
  title="Tags — log"
  description="記事をタグから探す。"
>
  <header class="page-head wrap">
    <p class="eyebrow">Tags</p>
    <h1 class="page-head__title">タグから探す</h1>
    <p class="page-head__lead">
      {sortedGroups.length} 種類のタグで {posts.length} 本の記事を整理しています。
    </p>
    <ul class="chip-row page-head__index">
      {
        sortedGroups.map((group) => (
          <li>
            <a class="chip" href={`#${group.tag}`}>
              {group.tag} <span class="chip__count">{group.posts.length}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </header>

  <div class="wrap tag-list">
    {
      sortedGroups.map((group) => (
        <section id={group.tag} class="tag-group" aria-labelledby={`tag-${group.tag}`}>
          <div class="tag-group__head">
            <h2 id={`tag-${group.tag}`} class="tag-group__title">
              <span class="tag-group__hash" aria-hidden="true">
                #
              </span>
              {group.tag}
            </h2>
            <span class="tag-group__count">{group.posts.length} 本</span>
          </div>
          <ul class="tag-group__posts">
            {group.posts.map((post) => {
              const photo = post.data.images[0];
              return (
                <li>
                  <a href={postUrl(post.id)}>
                    <img
                      src={mediaUrl(photo, Math.min(...photo.widths), 'webp')}
                      srcset={imageSrcSet(photo, 'webp')}
                      sizes="64px"
                      alt=""
                      width={photo.w}
                      height={photo.h}
                      loading="lazy"
                      decoding="async"
                      style={`--ph: ${photo.color}`}
                    />
                    <span>{post.data.title}</span>
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  .page-head {
    padding-block: clamp(2.5rem, 7vw, 4rem) clamp(1.5rem, 3vw, 2rem);
  }

  .page-head__title {
    font-size: clamp(1.6rem, 1.2rem + 2vw, 2.4rem);
    margin-top: 0.8rem;
  }

  .page-head__lead {
    margin: 0.9rem 0 0;
    color: var(--text-muted);
    font-size: 0.88rem;
  }

  .page-head__index {
    margin-top: 1.6rem;
    gap: 0.4rem;
  }

  .chip__count {
    font-variant-numeric: tabular-nums;
    opacity: 0.55;
    margin-left: 0.2em;
  }

  .tag-list {
    display: grid;
    gap: clamp(2rem, 5vw, 3rem);
    padding-bottom: 2rem;
  }

  .tag-group {
    scroll-margin-top: 6rem;
  }

  .tag-group__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.7rem;
    margin-bottom: 1.1rem;
    border-bottom: 1px solid var(--border);
  }

  .tag-group__title {
    font-size: 1.05rem;
    font-family: var(--font-sans);
    letter-spacing: 0.1em;
    font-weight: 600;
  }

  .tag-group__hash {
    color: var(--accent);
    margin-right: 0.1em;
  }

  .tag-group__count {
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    color: var(--text-faint);
  }

  .tag-group__posts {
    display: grid;
    /*
     * minmax(220px, 1fr) のままだと、項目の最小幅が中身の固有幅（長い記事
     * タイトル）になり、狭い画面で 1 列がはみ出す。最小を 0 にして、
     * タイトル側を省略表示で縮められるようにする。
     */
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
    gap: 0.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tag-group__posts li,
  .tag-group__posts a {
    min-width: 0;
  }

  .tag-group__posts a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.45rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elevated);
    text-decoration: none;
    font-size: 0.85rem;
    transition: border-color 0.2s var(--ease), transform 0.2s var(--ease);
  }

  .tag-group__posts a:hover {
    border-color: var(--accent);
    transform: translateY(-1px);
    color: var(--text);
  }

  .tag-group__posts img {
    width: 3.25rem;
    height: 3.25rem;
    flex: none;
    object-fit: cover;
    border-radius: calc(var(--radius) - 5px);
    background: var(--ph, var(--bg-sunken));
  }

  .tag-group__posts span {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
