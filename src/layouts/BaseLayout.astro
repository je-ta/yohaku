---
import '../styles/global.css';
import { url } from '../lib/gallery';

interface Props {
  title: string;
  description?: string;
  /** OGP 用の画像 URL */
  image?: string;
  /** 記事ページなど、一覧以外で使うときの type */
  type?: 'website' | 'article';
  noindex?: boolean;
  /** 先読みしておきたい画像 URL（LCP 候補） */
  preloadImage?: string;
}

const {
  title,
  description,
  image,
  type = 'website',
  noindex = false,
  preloadImage,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const ogImage = image ? new URL(image, Astro.site ?? Astro.url).href : undefined;
const siteName = 'log';
const year = new Date().getFullYear();

const navItems = [
  { href: url('/'), label: 'Posts' },
  { href: url('/tags/'), label: 'Tags' },
  { href: url('/about/'), label: 'About' },
];

const pathname = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === url('/') ? pathname === href : pathname.startsWith(href);
---

<!doctype html>
<html lang="ja" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={siteName} href={url('/rss.xml')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <meta name="theme-color" content="#fbfaf8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14130f" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />

    {
      preloadImage && (
        <link
          rel="preload"
          as="image"
          type="image/avif"
          href={preloadImage}
          fetchpriority="high"
        />
      )
    }

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta name="twitter:card" content="summary_large_image" />}
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="alternate icon" href={url('/favicon.ico')} sizes="32x32" />
  </head>
  <body>
    <a class="skip-link" href="#main">本文へスキップ</a>

    <header class="site-header">
      <div class="wrap site-header__inner">
        <a class="brand" href={url('/')}>
          <span class="brand__mark" aria-hidden="true"></span>
          <span>log</span>
          <span class="brand__sub">Photographs & Notes</span>
        </a>
        <nav class="site-nav" aria-label="メインナビゲーション">
          {
            navItems.map((item) => (
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap site-footer__inner">
        <p>© {year} {siteName}</p>
        <p>写真と文章の記録。</p>
      </div>
    </footer>

    {
      /*
       * 計測用のビーコン。1×1 の画像リクエスト 1 本だけで、JS は動かさない。
       * 静的アセットは Worker を通らないが、このパスだけ Worker 側で受ける。
       * loading="lazy" は付けない。付けると長い記事でフッターまでスクロール
       * しない限り発火せず、PV が過小に出る。画像は本文の後ろにあり、
       * <img> は描画をブロックしないので、即時読み込みでも体感は変わらない。
       */
    }
    <img
      src={url(`/__a.gif?p=${encodeURIComponent(Astro.url.pathname)}`)}
      alt=""
      width="1"
      height="1"
      decoding="async"
      referrerpolicy="no-referrer-when-downgrade"
      aria-hidden="true"
      class="beacon"
    />
  </body>
</html>
