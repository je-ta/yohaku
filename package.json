{
  "name": "yohaku",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "node scripts/fetch-images.mjs && node scripts/render-assets.mjs && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "sync": "astro sync",
    "new-post": "node scripts/new-post.mjs",
    "images": "node scripts/fetch-images.mjs",
    "add-photos": "node scripts/add-photos.mjs",
    "assets": "node scripts/render-assets.mjs",
    "worker": "wrangler dev",
    "db:schema": "wrangler d1 execute yohaku-analytics --remote --file=worker/schema.sql",
    "db:local": "wrangler d1 execute yohaku-analytics --local --file=worker/schema.sql",
    "deploy": "bun run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^5.20261025.1",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "wrangler": "^4.152.0"
  }
}
